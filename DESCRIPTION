Package: bgev
Type: Package
Title: Bimodal GEV Distribution with Location Parameter
Version: 0.3
Date: 2026-10-08
Authors@R: c(
    person("Thiago", "do Rego Sousa", role = c("aut", "cre"), email = "thiagodoregosousa@gmail.com"),
    person("Yasmin", "Lirio", role = "aut"),
    person("Cira Etheowalda", "Guevara Otiniano", role = "aut", email = "ciragotiniano@gmail.com"))
